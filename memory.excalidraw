    {
      "id": "mOg2EDIBglyLQootIvJwW",
      "type": "text",
      "x": 281.265625,
      "y": 2061.78125,
      "width": 800,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
